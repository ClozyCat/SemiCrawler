[Unit]
Description=SemiCrawler Chrome with Dokobot extension
Requires=semicrawler-xvfb.service
After=semicrawler-xvfb.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=semicrawler
Group=semicrawler
Environment=HOME=/home/semicrawler
Environment=DISPLAY=:99
ExecStart=/usr/bin/google-chrome-stable --user-data-dir=/home/semicrawler/.config/google-chrome --no-first-run --no-default-browser-check --disable-dev-shm-usage --ignore-certificate-errors --window-size=1920,1080 about:blank
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
