[Unit]
Description=SemiCrawler Crawl4AI browser extraction service
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/semicrawler/semicrawler.env
ExecStartPre=-/usr/bin/docker rm -f semicrawler-crawl4ai
ExecStart=/usr/bin/docker run --rm --name semicrawler-crawl4ai --shm-size=1g --memory=2g -p 127.0.0.1:11235:11235 -e CRAWL4AI_API_TOKEN unclecode/crawl4ai:0.9.3
ExecStop=/usr/bin/docker stop -t 20 semicrawler-crawl4ai
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
