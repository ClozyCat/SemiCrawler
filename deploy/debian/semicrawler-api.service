[Unit]
Description=SemiCrawler FastAPI service
Wants=network-online.target semicrawler-chrome.service
After=network-online.target semicrawler-chrome.service

[Service]
Type=simple
User=semicrawler
Group=semicrawler
WorkingDirectory=/opt/semicrawler
Environment=HOME=/home/semicrawler
Environment=PATH=/opt/semicrawler/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/semicrawler/semicrawler.env
ExecStart=/opt/semicrawler/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8070
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
