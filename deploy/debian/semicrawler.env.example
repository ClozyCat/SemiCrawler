# Copy to /etc/semicrawler/semicrawler.env and adjust paths when needed.
SEMICRAWLER_DATA_DIR=/var/lib/semicrawler/data
# Optional fallbacks when no search key is saved in API settings.
BAIDU_SEARCH_API_KEY=your-baidu-qianfan-key
TAVILY_API_KEY=tvly-your-key
ANYSEARCH_API_KEY=as_sk_your-key

# Crawl4AI browser-rendering sidecar. Use a long random token in production.
CRAWL4AI_ENABLED=true
CRAWL4AI_BASE_URL=http://127.0.0.1:11235
CRAWL4AI_API_TOKEN=replace-with-a-long-random-token
CRAWL4AI_TIMEOUT_SECONDS=90
CRAWL4AI_MIN_CONTENT_CHARS=200
