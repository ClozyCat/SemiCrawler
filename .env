# Python package index used while building the backend image.
PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# Leave empty to use SQLite at /app/data/semi_crawler.db.
SEMICRAWLER_DATABASE_URL=

# Optional web-search provider credentials. Configure the providers you use.
ANYSEARCH_API_KEY=
BAIDU_SEARCH_API_KEY=
BAIDU_API_KEY=
TAVILY_API_KEY=

# Crawl4AI service settings.
CRAWL4AI_ENABLED=true
CRAWL4AI_API_TOKEN=semicrawler-local-7f4a9d2e6c8143b0a5f8c1d9e2b647ac
CRAWL4AI_TIMEOUT_SECONDS=90
CRAWL4AI_MIN_CONTENT_CHARS=200
